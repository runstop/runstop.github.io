---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang, 'contact');
---

<Layout
  title={`${t("Contact Us")} - Art is the Game`}
  description={t("Have a question or feedback about our app? We'd love to hear from you! Fill out the form below and we'll get back to you as soon as possible.")}
  currentPage="contact"
  lang={lang}
>
  <div class="contact-page">
    <div id="contactStatusModal" class="success-modal-backdrop is-hidden" role="dialog" aria-modal="true" aria-labelledby="successModalTitle">
      <div class="success-modal">
        <h2 id="successModalTitle">Message Sent</h2>
        <p id="contactStatusMessage">Thanks. Your message was sent successfully, and we will get back to you soon.</p>
        <button id="contactStatusOk" class="success-ok-btn" type="button">OK</button>
      </div>
    </div>

    <div class="container">
      <header class="fade-in">
        <h1 class="contact-title">{t("Contact Us")}</h1>
      </header>
      <div class="contact-intro slide-up">
        <p class="contact-description">
          {t("Have a question or feedback about our app? We'd love to hear from you! Fill out the form below and we'll get back to you as soon as possible.")}
        </p>
      </div>

      <div class="form-container slide-up">
        <form id="contactForm" class="contact-form" action="https://formsubmit.co/ajax/pfarnam@icloud.com" method="POST">
          <input type="hidden" name="_subject" value="Artisthegame Support Form" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="form-group">
            <label for="name">{t("First Name")} <span class="required">*</span></label>
            <input type="text" id="name" name="name" required autofocus>
          </div>

          <div class="form-group">
            <label for="email">{t("Email Address")} <span class="required">*</span></label>
            <input type="email" id="email" name="email" required>
          </div>

          <div class="form-group">
            <label for="subject">{t("Subject")} <span class="required">*</span></label>
            <select id="subject" name="subject" required>
              <option value="">{t("Please select a subject")}</option>
              <option value="general">{t("General Inquiry")}</option>
              <option value="support">{t("App Support")}</option>
              <option value="feedback">{t("Feedback")}</option>
              <option value="business">{t("Business Inquiry")}</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">{t("Message")} <span class="required">*</span></label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <button id="contactSubmitBtn" type="submit" class="submit-btn">{t("Send Message")}</button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-page {
    min-height: 100vh;
    background: #000000;
    animation: fadeIn 1s ease-in;
    padding: 100px 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    animation: fadeIn 0.8s ease-out;
  }

  .slide-up {
    animation: slideUp 0.8s ease-out;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }

  header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #00ff41;
  }

  .contact-title {
    font-size: 4rem;
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 1rem;
    text-shadow: 0 0 20px #00ff41;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .contact-intro {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contact-description {
    font-size: 1.4rem;
    color: #cccccc;
    margin: 0;
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  .form-container {
    background: #111111;
    padding: 3rem;
    border-radius: 15px;
    border: 1px solid #333;
  }

  .success-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(3px);
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .success-modal-backdrop.is-hidden {
    display: none;
  }

  .success-modal {
    width: min(92vw, 520px);
    background: #111111;
    border: 1px solid #00ff41;
    border-radius: 14px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    padding: 28px 24px;
    text-align: center;
  }

  .success-modal h2 {
    margin: 0 0 12px;
    font-size: 1.8rem;
    color: #00ff41;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .success-modal p {
    margin: 0 0 22px;
    color: #e5e5e5;
    line-height: 1.6;
  }

  .success-ok-btn {
    cursor: pointer;
    display: inline-block;
    text-decoration: none;
    background: #00ff41;
    color: #000000;
    border: 2px solid #00ff41;
    border-radius: 999px;
    padding: 10px 28px;
    font-weight: 800;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .success-ok-btn:hover {
    background: transparent;
    color: #00ff41;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .form-group {
    margin-bottom: 2rem;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #ffffff;
    font-size: 1.1rem;
  }

  .required {
    color: #ff4444;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 1rem;
    border: 2px solid #333;
    border-radius: 8px;
    font-size: 1rem;
    background: #1a1a1a;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #00ff41;
    box-shadow: 0 0 0 3px rgba(0, 255, 65, 0.1);
    background: #222222;
  }

  .form-group textarea {
    min-height: 150px;
    resize: vertical;
  }

  .form-group select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=US-ASCII,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 5'><path fill='%23666' d='M2 0L0 2h4zm0 5L0 3h4z'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 12px;
    padding-right: 40px;
  }

  .submit-btn {
    background: #00ff41;
    color: #000000;
    font-weight: 900;
    padding: 1.25rem 2.5rem;
    border: 2px solid #00ff41;
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    display: block;
  }

  .submit-btn:hover {
    background: transparent;
    color: #00ff41;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 255, 65, 0.3);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .contact-page {
      padding: 50px 0;
    }

    .container {
      padding: 0 20px;
    }

    .form-container {
      padding: 2rem;
    }

    .contact-title {
      font-size: 3rem;
    }

    .contact-description {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .contact-title {
      font-size: 2.5rem;
    }

    .contact-description {
      font-size: 1.1rem;
    }

    .form-container {
      padding: 1.5rem;
    }
  }
</style>

<script>
  const initContactForm = () => {
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('contactSubmitBtn');
    const modal = document.getElementById('contactStatusModal');
    const modalTitle = document.getElementById('successModalTitle');
    const modalMessage = document.getElementById('contactStatusMessage');
    const modalOk = document.getElementById('contactStatusOk');

    if (!form || !submitBtn || !modal || !modalTitle || !modalMessage || !modalOk) return;
    if (form.dataset.jsInitialized === 'true') return;

    form.dataset.jsInitialized = 'true';

    const showModal = (title, message) => {
      modalTitle.textContent = title;
      modalMessage.textContent = message;
      modal.classList.remove('is-hidden');
    };

    const urlLikePattern = /\b(?:https?:\/\/|www\.|[a-z0-9-]+(?:\.[a-z0-9-]+)+(?:\/\S*)?)\b/i;
    const isLikelySpamSubmission = () => {
      const messageField = form.querySelector('#message');
      if (!(messageField instanceof HTMLTextAreaElement)) return false;

      const message = messageField.value.trim();
      if (!message) return false;

      return urlLikePattern.test(message);
    };

    const closeModal = () => {
      modal.classList.add('is-hidden');
    };

    modalOk.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (isLikelySpamSubmission()) {
        showModal('Message Sent', 'Thanks. Your message was sent successfully, and we will get back to you soon.');
        form.reset();
        return;
      }

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (!response.ok) {
          throw new Error('Request failed');
        }

        showModal('Message Sent', 'Thanks. Your message was sent successfully, and we will get back to you soon.');
        form.reset();
      } catch (_error) {
        showModal('Send Failed', 'We could not send your message right now. Please try again in a moment.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel || 'Send Message';
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true });
  } else {
    initContactForm();
  }
</script>
