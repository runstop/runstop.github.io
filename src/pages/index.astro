---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import companyLogo from '../assets/company-logo.png';
import headzoneIcon from '../assets/headzone-icon.png';
import screenshot1 from '../assets/screenshot-1.png';
import screenshot2 from '../assets/screenshot-2.png';
import screenshot3 from '../assets/screenshot-3.png';
import screenshot4 from '../assets/screenshot-4.png';
import screenshot5 from '../assets/screenshot-5.png';
import screenshot6 from '../assets/screenshot-6.png';
import profilePhoto from '../assets/profile-photo.jpg';
---

<Layout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
  currentPage="home"
>
	<div class="homepage">
		<div id="newsletterStatusModal" class="newsletter-modal-backdrop is-hidden" role="dialog" aria-modal="true" aria-labelledby="newsletterModalTitle">
			<div class="newsletter-modal">
				<h2 id="newsletterModalTitle">Subscription Sent</h2>
				<p id="newsletterStatusMessage">Thanks. Your subscription request was submitted successfully.</p>
				<button id="newsletterStatusOk" class="newsletter-ok-btn" type="button">OK</button>
			</div>
		</div>

		<!-- Hero Section -->
		<section class="hero fade-in">
			<div class="container">
				<div class="hero-content">
					<div class="company-icon">
						<img src={companyLogo.src} alt="Art is the Game" class="company-logo-img" />
					</div>
					<h1 class="hero-title">{siteConfig.companyName.toUpperCase()}</h1>
					<p class="hero-subtitle">Redesign Your Focus. Elevate Your Mind.</p>
					<p class="hero-description">
						We handcraft mobile apps for Apple devices that help you regain control in a distracted world — from boosting concentration to enhancing daily wellness.
					</p>
					<div class="cta-buttons">
						<a href={siteConfig.featuredApp.storeUrl} class="primary-btn" target="_blank" rel="noopener">Try Headzone</a>
						<a href="/apps" class="secondary-btn">View Our Apps</a>
					</div>
				</div>
			</div>
		</section>

		<!-- What We Do Section -->
		<section class="what-we-do slide-up">
			<div class="container">
				<h2 class="section-title">Helping You Thrive with Intentional Design</h2>
				<div class="mission-content">
					<p class="mission-text">
						At Art is the Game, we believe your phone apps should serve you — not stress you. Founded by Paul Farnam, we're an independent studio building tools for productivity, mental wellness, and mindful focus.
					</p>
					<p class="mission-text">
						Our flagship app, <strong>Headzone</strong>, is built on research into attention training. It's not about more screen time. It's about better attention. So you can do more, feel calmer, and stay present.
					</p>
					<div class="benefits-list">
						<div class="benefit-item">
							<div class="benefit-icon">🎯</div>
							<p>Tools built for real concentration, not distraction</p>
						</div>
						<div class="benefit-item">
							<div class="benefit-icon">✨</div>
							<p>Clean, intuitive experience — no fluff</p>
						</div>
						<div class="benefit-item">
							<div class="benefit-icon">🌱</div>
							<p>Apps that adapt to your life, not the other way around</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section class="about slide-up">
			<div class="container">
				<h2 class="section-title">Paul Farnam - Creative Mind Behind Art is the Game</h2>
				<div class="about-content">
					<div class="profile-section">
						<img src={profilePhoto.src} alt="Paul Farnam" class="profile-photo" />
					</div>
					<div class="about-text">
						<p>
							I started this studio to merge psychological research with design that feels good. My goal: empower people to feel more in control of their attention, mental energy, and daily flow.
						</p>
						<p>
							When you use a product from Art is the Game, you're getting more than code — you're getting intention.
						</p>
					</div>
					<div class="about-features">
						<div class="feature-item">
							<div class="feature-icon">🧠</div>
							<h4>Research-Driven</h4>
							<p>Built on psychology and focus training science</p>
						</div>
						<div class="feature-item">
							<div class="feature-icon">💝</div>
							<h4>Human-Centered</h4>
							<p>Designed with empathy and real user needs</p>
						</div>
						<div class="feature-item">
							<div class="feature-icon">🎯</div>
							<h4>Purposeful</h4>
							<p>Every feature serves your mental wellness</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Featured App Section -->
		<section class="featured-app slide-up">
			<div class="container">
				<h2 class="section-title">Featured App</h2>
				<div class="app-showcase">
					<div class="app-info">
						<div class="app-header">
							<div class="app-icon">
								<img src={headzoneIcon.src} alt="Headzone" class="app-icon-img" />
							</div>
							<div class="app-meta">
								<h3 class="app-title">{siteConfig.featuredApp.name}</h3>
								<p class="app-category">{siteConfig.featuredApp.category}</p>
								<div class="app-rating">
									<div class="stars">⭐⭐⭐⭐⭐</div>
									<span class="rating-text">{siteConfig.featuredApp.rating} Rating</span>
								</div>
							</div>
						</div>
						<p class="app-description">
							{siteConfig.featuredApp.description}
						</p>
						<div class="app-buttons">
							<a href={siteConfig.featuredApp.storeUrl} class="app-store-btn" target="_blank" rel="noopener">
								<img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" width="135" height="40" />
							</a>
							<a href="/apps" class="learn-more-btn">Learn More</a>
						</div>
					</div>
					<div class="app-preview">
						<div class="screenshot-gallery">
							<div class="screenshot-item">
								<img src={screenshot4.src} alt="Headzone Concentration Grid Practice" class="screenshot-img" />
							</div>
							<div class="screenshot-item">
								<img src={screenshot5.src} alt="Headzone Performance Scores" class="screenshot-img" />
							</div>
							<div class="screenshot-item">
								<img src={screenshot6.src} alt="Headzone Training Features" class="screenshot-img" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>


		<!-- Social Proof Section -->
		<section class="social-proof slide-up">
			<div class="container">
				<div class="proof-stats">
					<div class="stat-item">
						<div class="stat-number">⭐⭐⭐⭐⭐</div>
						<div class="stat-text">5.0 App Store Rating</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">100+</div>
						<div class="stat-text">Hours of Focus Trained</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">🔄</div>
						<div class="stat-text">Constantly Improving Based on User Feedback</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="cta-section slide-up">
			<div class="container">
				<h2>Ready to Get Started?</h2>
				<p>Take back your attention, calm your mind, and live more intentionally.</p>
				<div class="cta-buttons">
					<a href={siteConfig.featuredApp.storeUrl} class="primary-btn large" target="_blank" rel="noopener">Download Headzone</a>
					<a href="/apps" class="secondary-btn large">Explore Our Apps</a>
				</div>
			</div>
		</section>

		<!-- Newsletter Section -->
		<section class="newsletter-section slide-up" id="newsletter">
			<div class="container">
				<div class="newsletter-content">
					<div class="newsletter-text">
						<h2 class="newsletter-title">Stay in the Loop</h2>
						<p class="newsletter-subtitle">Join our newsletter for exclusive updates and insider access</p>
						<div class="newsletter-benefits">
							<div class="benefit-item">
								<div class="benefit-icon">📰</div>
								<p>Latest news and app updates</p>
							</div>
							<div class="benefit-item">
								<div class="benefit-icon">🔮</div>
								<p>Inside scoop on new features in development</p>
							</div>
							<div class="benefit-item">
								<div class="benefit-icon">🎟️</div>
								<p>Exclusive promo codes and early access</p>
							</div>
						</div>
					</div>
					<div class="newsletter-form-container">
						<form id="newsletterForm" class="newsletter-form" action="https://formsubmit.co/ajax/pfarnam@icloud.com" method="POST">
							<input type="hidden" name="_subject" value="Artisthegame Newsletter Signup" />
							<input type="hidden" name="_captcha" value="false" />
							<input type="hidden" name="source" value="newsletter-homepage" />
							<input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
							<div class="form-group">
								<label for="newsletterEmail">Email Address</label>
								<input type="email" id="newsletterEmail" name="email" placeholder="Enter your email" required>
							</div>
							<button id="newsletterSubmitBtn" type="submit" class="newsletter-submit-btn">Subscribe</button>
						</form>
						<p class="newsletter-privacy">
							We respect your privacy. Unsubscribe anytime. <a href="/privacy">Privacy Policy</a>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<div class="footer-content">
					<div class="footer-brand">
						<h3>{siteConfig.companyName}</h3>
						<p>Professional iOS App Development</p>
					</div>
					<div class="footer-links">
						<a href="/apps">Apps</a>
						<a href="/contact">Contact</a>
						<a href="/privacy">Privacy Policy</a>
						<a href="/terms">Terms of Service</a>
					</div>
				</div>
				<div class="footer-bottom">
					<p>&copy; {siteConfig.currentYear} {siteConfig.companyName}. All rights reserved.</p>
				</div>
			</div>
		</footer>
	</div>

	<style>
		.homepage {
			min-height: 100vh;
			background: #000000;
			animation: fadeIn 1s ease-in;
		}

		@keyframes fadeIn {
			from { opacity: 0; }
			to { opacity: 1; }
		}

		@keyframes slideUp {
			from {
				opacity: 0;
				transform: translateY(30px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.fade-in {
			animation: fadeIn 0.8s ease-out;
		}

		.slide-up {
			animation: slideUp 0.8s ease-out;
		}

		.container {
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
		}

		/* Hero Section */
		.hero {
			padding: 100px 0;
			text-align: center;
			color: white;
		}

		.hero-content {
			max-width: 700px;
			margin: 0 auto;
		}

		.company-icon {
			margin-bottom: 30px;
		}

		.company-logo-img {
			width: 120px;
			height: 120px;
			border-radius: 27px;
			margin: 0 auto;
			box-shadow: 0 20px 40px rgba(0, 255, 65, 0.3);
			border: 2px solid #ffffff;
			display: block;
		}

		.hero-title {
			font-size: 5rem;
			font-weight: 900;
			margin: 30px 0 15px;
			color: #ffffff;
			text-shadow: 0 0 20px #00ff41;
			letter-spacing: 3px;
			line-height: 1.1;
		}

		.hero-subtitle {
			font-size: 2.2rem;
			font-weight: 400;
			margin-bottom: 25px;
			opacity: 0.95;
			color: #00ff41;
			text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
			letter-spacing: 1px;
		}

		.hero-description {
			font-size: 1.1rem;
			line-height: 1.6;
			margin-bottom: 40px;
			opacity: 0.8;
		}

		.cta-buttons {
			display: flex;
			gap: 20px;
			justify-content: center;
			flex-wrap: wrap;
		}

		.primary-btn, .secondary-btn {
			display: inline-block;
			padding: 15px 30px;
			border-radius: 25px;
			text-decoration: none;
			font-weight: 600;
			transition: all 0.2s ease;
		}

		.primary-btn {
			background: #00ff41;
			color: #000000;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 1px;
			border: 2px solid #00ff41;
		}

		.primary-btn:hover {
			background: transparent;
			color: #00ff41;
			transform: translateY(-2px);
			box-shadow: 0 10px 25px rgba(0, 255, 65, 0.3);
		}

		.secondary-btn {
			background: transparent;
			color: #ffffff;
			border: 2px solid #ffffff;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		.secondary-btn:hover {
			background: #ffffff;
			color: #000000;
			transform: translateY(-2px);
		}

		.primary-btn.large {
			padding: 18px 40px;
			font-size: 1.1rem;
		}

		/* What We Do Section */
		.what-we-do {
			padding: 100px 0;
			background: #0a0a0a;
			color: #ffffff;
		}

		.mission-content {
			max-width: 800px;
			margin: 0 auto;
			text-align: center;
		}

		.mission-text {
			font-size: 1.2rem;
			line-height: 1.7;
			margin-bottom: 30px;
			opacity: 0.9;
		}

		.mission-text strong {
			color: #00ff41;
			font-weight: 700;
		}

		.benefits-list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 30px;
			margin-top: 50px;
		}

		.benefit-item {
			background: #111111;
			padding: 30px 20px;
			border-radius: 15px;
			border: 1px solid #333;
			transition: all 0.3s ease;
		}

		.benefit-item:hover {
			transform: translateY(-5px);
			border-color: #00ff41;
			box-shadow: 0 10px 30px rgba(0, 255, 65, 0.1);
		}

		.benefit-icon {
			font-size: 2rem;
			margin-bottom: 15px;
		}

		.benefit-item p {
			font-size: 1rem;
			line-height: 1.5;
			margin: 0;
		}

		/* Social Proof Section */
		.social-proof {
			padding: 60px 0;
			background: #000000;
			border-top: 1px solid #333;
			border-bottom: 1px solid #333;
		}

		.proof-stats {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 40px;
			text-align: center;
		}

		.stat-item {
			padding: 20px;
		}

		.stat-number {
			font-size: 2rem;
			font-weight: 900;
			color: #00ff41;
			margin-bottom: 10px;
			text-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
		}

		.stat-text {
			font-size: 1rem;
			color: #ffffff;
			opacity: 0.8;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		/* Featured App Section */
		.featured-app {
			padding: 100px 0;
			background: #111111;
			color: #ffffff;
			border-top: 2px solid #00ff41;
		}

		.section-title {
			text-align: center;
			font-size: 3.2rem;
			font-weight: 900;
			margin-bottom: 60px;
			color: #ffffff;
			text-transform: uppercase;
			letter-spacing: 3px;
			text-shadow: 0 0 15px #00ff41;
			line-height: 1.2;
		}

		.app-showcase {
			max-width: 1000px;
			margin: 0 auto;
		}

		.app-header {
			display: flex;
			gap: 20px;
			margin-bottom: 25px;
			align-items: center;
		}

		.app-icon-img {
			width: 70px;
			height: 70px;
			border-radius: 16px;
			box-shadow: 0 10px 30px rgba(0, 255, 65, 0.4);
			border: 2px solid #ffffff;
		}

		.app-title {
			font-size: 2rem;
			font-weight: 900;
			margin: 0 0 5px 0;
			color: #ffffff;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		.app-category {
			color: #00ff41;
			font-weight: 700;
			margin: 0 0 10px 0;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.app-rating {
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.stars {
			font-size: 1rem;
		}

		.rating-text {
			color: #718096;
			font-size: 0.9rem;
		}

		.app-description {
			font-size: 1.1rem;
			line-height: 1.7;
			color: #cccccc;
			margin-bottom: 30px;
		}

		.app-buttons {
			display: flex;
			gap: 20px;
			align-items: center;
			flex-wrap: wrap;
		}

		.app-store-btn {
			display: inline-block;
			transition: transform 0.2s ease;
		}

		.app-store-btn:hover {
			transform: translateY(-2px);
		}

		.learn-more-btn {
			color: #00ff41;
			text-decoration: none;
			font-weight: 800;
			padding: 10px 20px;
			border: 2px solid #00ff41;
			border-radius: 10px;
			transition: all 0.2s ease;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.learn-more-btn:hover {
			background: #00ff41;
			color: #000000;
			transform: translateY(-1px);
		}

		/* Screenshot Gallery */
		.screenshot-gallery {
			display: flex;
			gap: 20px;
			justify-content: center;
			margin-top: 40px;
			flex-wrap: wrap;
		}

		.screenshot-item {
			background: #222222;
			border-radius: 15px;
			padding: 10px;
			box-shadow: 0 15px 30px rgba(0, 255, 65, 0.2);
			border: 2px solid #00ff41;
			transition: all 0.3s ease;
			flex: 0 0 auto;
			width: 200px;
		}

		.screenshot-item:hover {
			transform: translateY(-5px);
			box-shadow: 0 20px 40px rgba(0, 255, 65, 0.3);
		}

		.screenshot-img {
			width: 100%;
			height: auto;
			border-radius: 10px;
			display: block;
		}

		/* App Preview */
		.phone-mockup {
			background: #333;
			border-radius: 25px;
			padding: 15px;
			aspect-ratio: 9/19.5;
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
			max-width: 250px;
			margin: 0 auto;
		}

		.screen {
			background: #000000;
			border: 2px solid #00ff41;
			border-radius: 18px;
			width: 100%;
			height: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #ffffff;
			font-weight: 700;
			text-align: center;
		}

		.app-demo {
			padding: 20px;
		}

		.demo-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 8px;
			margin-bottom: 15px;
		}

		.grid-cell {
			background: #00ff41;
			color: #000000;
			border-radius: 6px;
			padding: 12px;
			font-size: 1rem;
			font-weight: 900;
			text-align: center;
			border: 1px solid #ffffff;
		}

		.demo-text {
			font-size: 0.9rem;
			opacity: 0.9;
			margin: 0;
		}

		/* About Section */
		.about {
			padding: 100px 0;
			background: #000000;
			color: #ffffff;
			border-top: 2px solid #00ff41;
		}

		.about-content {
			display: grid;
			grid-template-columns: 200px 1fr 300px;
			gap: 50px;
			align-items: start;
			max-width: 1200px;
			margin: 0 auto;
		}

		.profile-section {
			display: flex;
			justify-content: center;
		}

		.profile-photo {
			width: 180px;
			height: 180px;
			border-radius: 50%;
			object-fit: cover;
			box-shadow: 0 20px 40px rgba(0, 255, 65, 0.3);
			border: 4px solid #ffffff;
		}

		.about-text p {
			font-size: 1.1rem;
			line-height: 1.7;
			margin-bottom: 20px;
			opacity: 0.9;
		}

		.about-features {
			display: grid;
			gap: 30px;
		}

		.feature-item {
			text-align: center;
			padding: 25px;
			background: #111111;
			border-radius: 15px;
			border: 2px solid #00ff41;
			transition: all 0.3s ease;
		}

		.feature-item:hover {
			background: #00ff41;
			color: #000000;
			transform: translateY(-5px);
		}

		.feature-icon {
			font-size: 2.5rem;
			margin-bottom: 15px;
		}

		.feature-item h4 {
			font-size: 1.1rem;
			margin-bottom: 10px;
			font-weight: 600;
		}

		.feature-item p {
			font-size: 0.9rem;
			opacity: 0.8;
			margin: 0;
		}

		/* CTA Section */
		.cta-section {
			padding: 100px 0;
			background: #111111;
			text-align: center;
			color: #ffffff;
			border-top: 2px solid #00ff41;
		}

		.cta-section h2 {
			font-size: 2.5rem;
			font-weight: 900;
			margin-bottom: 20px;
			color: #ffffff;
			text-transform: uppercase;
			letter-spacing: 2px;
			text-shadow: 0 0 15px #00ff41;
		}

		.cta-section p {
			font-size: 1.2rem;
			margin-bottom: 40px;
			color: #cccccc;
		}

		/* Footer */
		.footer {
			padding: 60px 0 30px;
			background: #000000;
