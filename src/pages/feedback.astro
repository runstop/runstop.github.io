<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('feedbackForm');
    const submitBtn = document.getElementById('feedbackSubmitBtn');
    const status = document.getElementById('feedbackFormStatus');
    const successPanel = document.getElementById('feedbackSuccess');
    const subscriptionFollowup = document.getElementById('subscriptionFollowup');

    if (!form || !submitBtn || !status || !successPanel || !subscriptionFollowup) return;

    const otherWrappers = Array.from(form.querySelectorAll('[data-other-wrapper]'));
    const otherToggles = Array.from(form.querySelectorAll('[data-other-target]'));
    const subscriptionInputs = Array.from(form.querySelectorAll('input[name="q18_subscription_status"]'));
    const requiredCheckboxGroups = Array.from(form.querySelectorAll('[data-required-checkbox-group]'));

    const setStatus = (message) => {
      status.textContent = message;
      status.classList.remove('is-hidden');
      status.classList.add('is-error');
    };

    const clearStatus = () => {
      status.textContent = '';
      status.classList.add('is-hidden');
      status.classList.remove('is-error');
    };

    const clearFieldValue = (field) => {
      if (field instanceof HTMLInputElement && (field.type === 'checkbox' || field.type === 'radio')) {
        field.checked = false;
        return;
      }

      field.value = '';
    };

    const syncOtherWrapper = (wrapperId) => {
      const wrapper = document.getElementById(wrapperId);
      if (!wrapper) return;

      const relatedToggles = Array.from(form.querySelectorAll(`[data-other-target="${wrapperId}"]`));
      const isVisible = relatedToggles.some((input) => !input.disabled && input.checked);

      wrapper.hidden = !isVisible;

      Array.from(wrapper.querySelectorAll('input, textarea')).forEach((field) => {
        const shouldRequire = isVisible && field.dataset.requiredWhenVisible === 'true';
        field.disabled = !isVisible;
        field.required = shouldRequire;

        if (!isVisible) {
          clearFieldValue(field);
        }
      });
    };

    const syncAllOtherWrappers = () => {
      otherWrappers.forEach((wrapper) => syncOtherWrapper(wrapper.id));
    };

    const syncSubscriptionFollowup = () => {
      const selectedValue = subscriptionInputs.find((input) => input.checked)?.value;
      const shouldShow = selectedValue && selectedValue !== 'already-subscribe';

      subscriptionFollowup.hidden = !shouldShow;

      Array.from(subscriptionFollowup.querySelectorAll('input, textarea')).forEach((field) => {
        field.disabled = !shouldShow;
        field.required = shouldShow && field.dataset.requiredWhenVisible === 'true';

        if (!shouldShow) {
          clearFieldValue(field);
        }
      });

      syncAllOtherWrappers();
    };

    const validateCheckboxGroup = (group) => {
      const checkboxes = Array.from(group.querySelectorAll('input[type="checkbox"]')).filter((input) => !input.disabled);
      const valid = checkboxes.some((input) => input.checked);
      const error = group.querySelector('.group-error');

      group.classList.toggle('has-error', !valid);
      if (error) {
        error.hidden = valid;
      }

      return valid;
    };

    const validateRequiredCheckboxGroups = () => {
      let firstInvalidGroup = null;

      requiredCheckboxGroups.forEach((group) => {
        const isValid = validateCheckboxGroup(group);
        if (!isValid && !firstInvalidGroup) {
          firstInvalidGroup = group;
        }
      });

      return firstInvalidGroup;
    };

    otherToggles.forEach((input) => {
      input.addEventListener('change', () => {
        syncOtherWrapper(input.dataset.otherTarget);
      });
    });

    subscriptionInputs.forEach((input) => {
      input.addEventListener('change', syncSubscriptionFollowup);
    });

    requiredCheckboxGroups.forEach((group) => {
      Array.from(group.querySelectorAll('input[type="checkbox"]')).forEach((input) => {
        input.addEventListener('change', () => {
          validateCheckboxGroup(group);
        });
      });
    });

    syncSubscriptionFollowup();
    syncAllOtherWrappers();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearStatus();

      const invalidGroup = validateRequiredCheckboxGroups();
      if (invalidGroup) {
        setStatus('Please answer the highlighted checkbox question before submitting.');
        invalidGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
        invalidGroup.querySelector('input')?.focus();
        return;
      }

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (!response.ok) {
          throw new Error('Request failed');
        }

        form.hidden = true;
        successPanel.classList.remove('is-hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        successPanel.focus();
      } catch (_error) {
        setStatus('We could not send your survey right now. Please try again in a moment.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel || 'Send survey and show my code';
      }
    });
  });
</script>
