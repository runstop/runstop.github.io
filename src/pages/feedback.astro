---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Headzone Feedback Survey - Art is the Game"
  description="Share your feedback about Headzone in 7 quick questions and receive a free week of Headzone Pro."
  currentPage=""
  lang="en-US"
>
  <div class="feedback-page">
    <div class="container">
      <header class="hero fade-in">
        <span class="eyebrow">Headzone feedback survey</span>
        <h1>7 quick questions</h1>
        <p class="hero-copy">
          I trimmed this survey down to the feedback that matters most: who Headzone is for, what value is clear,
          what still feels rough, and the one change that would make the app more worth using.
        </p>
        <div class="hero-meta">
          <span>About 2 minutes</span>
          <span>7 focused questions</span>
          <span>Reward: 1 free week of Headzone Pro</span>
        </div>
      </header>

      <section id="feedbackSuccess" class="success-panel is-hidden" aria-live="polite" tabindex="-1">
        <div class="success-copy">
          <span class="success-kicker">Thank you</span>
          <h2>Thanks for helping shape Headzone</h2>
          <p>
            As promised, here is your free week of Headzone Pro. Use the button below to open Apple's redemption
            screen with your code ready, or enter the code manually inside Headzone if you prefer.
          </p>
        </div>

        <div class="reward-card">
          <div>
            <p class="reward-label">Your reward</p>
            <h3>1 free week of Headzone Pro</h3>
          </div>
          <div class="reward-code-block">
            <span class="reward-code-label">Redemption code</span>
            <code id="rewardCodeValue"></code>
          </div>
        </div>

        <div class="redeem-action-row">
          <a
            id="redeemNowButton"
            class="redeem-now-btn"
            href="#"
            rel="nofollow"
          >
            Redeem In The App Store
          </a>
        </div>

        <div class="redeem-steps">
          <h3>How to redeem</h3>
          <ol>
            <li>Tap <strong>Redeem In The App Store</strong> above.</li>
            <li>Confirm the free-week offer from Apple.</li>
            <li>Return to Headzone and refresh if the upgrade does not appear right away.</li>
          </ol>
          <p class="redeem-note">
            If you would rather redeem inside Headzone, open the upgrade screen and tap <strong>Redeem Free Week Code</strong>,
            then enter the code shown above.
          </p>
        </div>
      </section>

      <section class="form-shell slide-up">
        <div class="form-shell-header">
          <div>
            <p class="section-label">Survey</p>
            <h2>Tell me what matters most</h2>
            <p class="intro-copy">
              Most answers are one tap. The final question is where you can tell me the one thing I should improve
              next.
            </p>
          </div>
          <p class="privacy-note">
            Your responses are sent through the same secure FormSubmit flow already used on artisthegame.com. After a
            successful submission, your reward code appears immediately on this page.
          </p>
        </div>

        <p id="feedbackFormStatus" class="form-status is-hidden" role="alert"></p>

        <form
          id="feedbackForm"
          class="feedback-form"
          action="https://formsubmit.co/ajax/pfarnam@icloud.com"
          method="POST"
        >
          <input type="hidden" name="_subject" value="Headzone Feedback Survey" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="submission_source" value="headzone-feedback-survey" />
          <input type="hidden" name="submission_origin" value="artisthegame.com/feedback" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="survey-grid">
            <fieldset class="question-card question-card--wide">
              <legend>1. What best describes you, and what sport or performance area matters most right now? <span class="required">*</span></legend>
              <div class="choices-grid choices-grid--dense">
                <label class="choice-pill"><input type="radio" name="q01_role" value="Competitive athlete" required /> <span>Competitive athlete</span></label>
                <label class="choice-pill"><input type="radio" name="q01_role" value="Recreational athlete" /> <span>Recreational athlete</span></label>
                <label class="choice-pill"><input type="radio" name="q01_role" value="Coach or trainer" /> <span>Coach or trainer</span></label>
                <label class="choice-pill"><input type="radio" name="q01_role" value="Parent of an athlete" /> <span>Parent of an athlete</span></label>
                <label class="choice-pill"><input type="radio" name="q01_role" value="Student or professional" /> <span>Student or professional</span></label>
                <label class="choice-pill"><input type="radio" name="q01_role" value="Other" data-other-target="q01RoleOther" /> <span>Other</span></label>
              </div>
              <div class="inline-fields">
                <div id="q01RoleOther" class="other-input field-stack" data-other-wrapper hidden>
                  <label class="question-label" for="q01RoleOtherText">If other, tell me a little more</label>
                  <input
                    id="q01RoleOtherText"
                    type="text"
                    name="q01_role_other"
                    placeholder="Your role"
                    data-required-when-visible="true"
                    disabled
                  />
                </div>
                <div class="field-stack">
                  <label class="question-label" for="q01PrimaryFocus">Sport or performance area</label>
                  <input
                    id="q01PrimaryFocus"
                    type="text"
                    name="q01_primary_focus"
                    placeholder="Sport, position, or performance area"
                    required
                  />
                </div>
              </div>
            </fieldset>

            <fieldset class="question-card">
              <legend>2. What were you hoping Headzone would help you improve first? <span class="required">*</span></legend>
              <div class="choices-grid">
                <label class="choice-pill"><input type="radio" name="q02_primary_goal" value="Focus under pressure" required /> <span>Focus under pressure</span></label>
                <label class="choice-pill"><input type="radio" name="q02_primary_goal" value="Recognition and decision speed" /> <span>Recognition and decision speed</span></label>
                <label class="choice-pill"><input type="radio" name="q02_primary_goal" value="Reset after mistakes" /> <span>Reset after mistakes</span></label>
                <label class="choice-pill"><input type="radio" name="q02_primary_goal" value="Consistency and endurance" /> <span>Consistency and endurance</span></label>
                <label class="choice-pill"><input type="radio" name="q02_primary_goal" value="General mental performance" /> <span>General mental performance</span></label>
                <label class="choice-pill"><input type="radio" name="q02_primary_goal" value="Other" data-other-target="q02GoalOther" /> <span>Other</span></label>
              </div>
              <div id="q02GoalOther" class="other-input field-stack" data-other-wrapper hidden>
                <label class="question-label" for="q02GoalOtherText">If other, what were you hoping to improve?</label>
                <input
                  id="q02GoalOtherText"
                  type="text"
                  name="q02_primary_goal_other"
                  placeholder="Your answer"
                  data-required-when-visible="true"
                  disabled
                />
              </div>
            </fieldset>

            <fieldset class="question-card">
              <legend>3. How easy was it to get started? <span class="required">*</span></legend>
              <p class="helper-text">1 = Very confusing, 5 = Very easy</p>
              <div class="scale-grid">
                <label class="scale-pill"><input type="radio" name="q03_getting_started" value="1" required /> <span>1</span></label>
                <label class="scale-pill"><input type="radio" name="q03_getting_started" value="2" /> <span>2</span></label>
                <label class="scale-pill"><input type="radio" name="q03_getting_started" value="3" /> <span>3</span></label>
                <label class="scale-pill"><input type="radio" name="q03_getting_started" value="4" /> <span>4</span></label>
                <label class="scale-pill"><input type="radio" name="q03_getting_started" value="5" /> <span>5</span></label>
              </div>
            </fieldset>

            <fieldset class="question-card">
              <legend>4. What felt weakest or most confusing so far? <span class="required">*</span></legend>
              <div class="choices-grid">
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Onboarding or setup" required /> <span>Onboarding or setup</span></label>
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Understanding the point of each drill" /> <span>Understanding the point of each drill</span></label>
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Choosing a training mode" /> <span>Choosing a training mode</span></label>
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Results or coaching explanation" /> <span>Results or coaching explanation</span></label>
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Subscription or paywall messaging" /> <span>Subscription or paywall messaging</span></label>
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Nothing felt weak" /> <span>Nothing felt weak</span></label>
                <label class="choice-pill"><input type="radio" name="q04_weakest_point" value="Other" data-other-target="q04WeakestOther" /> <span>Other</span></label>
              </div>
              <div id="q04WeakestOther" class="other-input field-stack" data-other-wrapper hidden>
                <label class="question-label" for="q04WeakestOtherText">If other, what stood out?</label>
                <input
                  id="q04WeakestOtherText"
                  type="text"
                  name="q04_weakest_point_other"
                  placeholder="Your answer"
                  data-required-when-visible="true"
                  disabled
                />
              </div>
            </fieldset>

            <fieldset class="question-card">
              <legend>5. How clear is the value of Headzone to you right now? <span class="required">*</span></legend>
              <p class="helper-text">1 = Not clear at all, 5 = Extremely clear</p>
              <div class="scale-grid">
                <label class="scale-pill"><input type="radio" name="q05_value_clarity" value="1" required /> <span>1</span></label>
                <label class="scale-pill"><input type="radio" name="q05_value_clarity" value="2" /> <span>2</span></label>
                <label class="scale-pill"><input type="radio" name="q05_value_clarity" value="3" /> <span>3</span></label>
                <label class="scale-pill"><input type="radio" name="q05_value_clarity" value="4" /> <span>4</span></label>
                <label class="scale-pill"><input type="radio" name="q05_value_clarity" value="5" /> <span>5</span></label>
              </div>
            </fieldset>

            <fieldset class="question-card">
              <legend>6. How connected does the training feel to real-world performance? <span class="required">*</span></legend>
              <p class="helper-text">1 = Feels abstract, 5 = Feels directly useful</p>
              <div class="scale-grid">
                <label class="scale-pill"><input type="radio" name="q06_real_world_connection" value="1" required /> <span>1</span></label>
                <label class="scale-pill"><input type="radio" name="q06_real_world_connection" value="2" /> <span>2</span></label>
                <label class="scale-pill"><input type="radio" name="q06_real_world_connection" value="3" /> <span>3</span></label>
                <label class="scale-pill"><input type="radio" name="q06_real_world_connection" value="4" /> <span>4</span></label>
                <label class="scale-pill"><input type="radio" name="q06_real_world_connection" value="5" /> <span>5</span></label>
              </div>
            </fieldset>

            <fieldset class="question-card question-card--wide">
              <legend>7. If I could fix one thing next, what would most increase the value of Headzone for you? <span class="required">*</span></legend>
              <label class="question-label" for="q07ImproveNext">
                This can be about onboarding, training quality, coaching, subscription value, or anything else.
              </label>
              <textarea
                id="q07ImproveNext"
                name="q07_improve_next"
                rows="5"
                placeholder="The one change that would make the biggest difference"
                required
              ></textarea>
            </fieldset>
          </div>

          <div class="contact-card">
            <div class="contact-copy">
              <h3>Optional follow-up</h3>
              <p>Leave your email if you want me to follow up about your feedback or invite you to test improvements.</p>
            </div>
            <div class="field-stack">
              <label class="question-label" for="q08Email">Email address</label>
              <input id="q08Email" type="email" name="email" inputmode="email" autocomplete="email" placeholder="name@example.com" />
            </div>
          </div>

          <div class="form-actions">
            <p class="submit-note">Your reward code appears immediately after a successful submission.</p>
            <button id="feedbackSubmitBtn" type="submit" class="submit-btn">Send survey and show my code</button>
          </div>
        </form>
      </section>
    </div>
  </div>
</Layout>

<style>
  .feedback-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at top, rgba(0, 255, 65, 0.14), transparent 28%),
      linear-gradient(180deg, #040404 0%, #000000 100%);
    padding: 88px 0 72px;
  }

  .container {
    width: min(100%, 980px);
    margin: 0 auto;
    padding: 0 18px;
  }

  .fade-in {
    animation: fadeIn 0.8s ease-out;
  }

  .slide-up {
    animation: slideUp 0.8s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero,
  .success-panel,
  .form-shell {
    border: 1px solid rgba(0, 255, 65, 0.18);
    background: rgba(12, 12, 12, 0.92);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(10px);
  }

  .hero {
    border-radius: 28px;
    padding: 28px;
    margin-bottom: 22px;
  }

  .eyebrow,
  .success-kicker,
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8dffad;
    font-weight: 800;
  }

  .hero h1 {
    margin: 14px 0 12px;
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-shadow: 0 0 18px rgba(0, 255, 65, 0.24);
  }

  .hero-copy,
  .intro-copy,
  .privacy-note,
  .submit-note,
  .helper-text,
  .redeem-note,
  .contact-copy p,
  .success-copy p {
    color: #d6d6d6;
  }

  .hero-copy {
    max-width: 760px;
    margin: 0;
    font-size: 1.03rem;
    line-height: 1.72;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .hero-meta span {
    border-radius: 999px;
    border: 1px solid rgba(0, 255, 65, 0.22);
    background: rgba(0, 255, 65, 0.08);
    padding: 10px 14px;
    font-size: 0.95rem;
    color: #f0f0f0;
  }

  .success-panel {
    border-radius: 26px;
    padding: 28px;
    margin-bottom: 22px;
  }

  .success-panel.is-hidden,
  .form-status.is-hidden {
    display: none;
  }

  .success-copy p {
    margin: 0;
    max-width: 720px;
    line-height: 1.7;
  }

  .reward-card {
    margin: 24px 0 20px;
    border-radius: 20px;
    border: 1px solid rgba(0, 255, 65, 0.22);
    background: linear-gradient(135deg, rgba(0, 255, 65, 0.1), rgba(0, 255, 65, 0.03));
    padding: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }

  .reward-label,
  .reward-code-label {
    margin: 0 0 6px;
    font-size: 0.86rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8dffad;
  }

  .reward-card h3,
  .redeem-steps h3,
  .contact-copy h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .reward-code-block {
    min-width: min(100%, 320px);
  }

  .redeem-action-row {
    margin-bottom: 20px;
  }

  .redeem-now-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 20px;
    border-radius: 999px;
    background: linear-gradient(135deg, #8dffad 0%, #2df56d 100%);
    color: #041105;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 16px 30px rgba(45, 245, 109, 0.18);
  }

  .redeem-now-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 20px 34px rgba(45, 245, 109, 0.24);
  }

  .reward-code-block code {
    display: inline-block;
    width: 100%;
    padding: 16px 18px;
    border-radius: 16px;
    background: #050505;
    border: 1px dashed rgba(0, 255, 65, 0.4);
    color: #ffffff;
    font-size: clamp(1rem, 3vw, 1.35rem);
    letter-spacing: 0.12em;
    word-break: break-word;
  }

  .redeem-steps ol {
    margin: 14px 0 0;
    padding-left: 20px;
    color: #f0f0f0;
  }

  .redeem-steps li + li {
    margin-top: 8px;
  }

  .form-shell {
    border-radius: 30px;
    padding: 24px;
  }

  .form-shell-header {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: 16px;
    align-items: end;
    margin-bottom: 18px;
  }

  .form-shell-header h2,
  .success-panel h2 {
    margin: 0 0 10px;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
  }

  .intro-copy,
  .privacy-note {
    margin: 0;
    line-height: 1.6;
  }

  .form-status {
    margin: 0 0 18px;
    padding: 14px 16px;
    border-radius: 14px;
    font-weight: 600;
  }

  .form-status.is-error {
    background: rgba(255, 92, 92, 0.12);
    border: 1px solid rgba(255, 92, 92, 0.38);
    color: #ffd8d8;
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .survey-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    align-items: start;
  }

  .question-card,
  .contact-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
  }

  .question-card {
    padding: 18px;
  }

  .question-card--wide,
  .contact-card {
    grid-column: 1 / -1;
  }

  fieldset {
    min-width: 0;
    margin: 0;
  }

  legend {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
    margin-bottom: 14px;
    padding: 0;
  }

  .required {
    color: #ff7474;
  }

  .helper-text,
  .question-label {
    font-size: 0.94rem;
  }

  .helper-text {
    margin: 0 0 12px;
  }

  .question-label {
    color: #dadada;
    line-height: 1.45;
  }

  .choices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }

  .choices-grid--dense {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .choice-pill,
  .scale-pill {
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 54px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    padding: 12px 14px;
    color: #f2f2f2;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }

  .choice-pill:hover,
  .scale-pill:hover {
    transform: translateY(-1px);
    border-color: rgba(0, 255, 65, 0.34);
    background: rgba(0, 255, 65, 0.06);
  }

  .choice-pill input,
  .scale-pill input {
    margin: 0;
    accent-color: #00ff41;
    flex-shrink: 0;
  }

  .choice-pill span {
    line-height: 1.4;
  }

  .scale-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .scale-pill {
    justify-content: center;
    padding: 14px 10px;
  }

  .scale-pill span {
    font-size: 1.05rem;
    font-weight: 800;
  }

  .inline-fields {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 12px;
    margin-top: 14px;
  }

  .field-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: #0e0e0e;
    color: #ffffff;
    padding: 13px 15px;
    font: inherit;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  input[type='text']:focus,
  input[type='email']:focus,
  textarea:focus {
    outline: none;
    border-color: rgba(0, 255, 65, 0.7);
    box-shadow: 0 0 0 4px rgba(0, 255, 65, 0.11);
    background: #121212;
  }

  textarea {
    min-height: 120px;
    resize: vertical;
  }

  .other-input {
    margin-top: 14px;
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1.1fr);
    gap: 16px;
    padding: 18px;
  }

  .contact-copy p {
    margin: 8px 0 0;
    line-height: 1.6;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .submit-note {
    margin: 0;
    max-width: 560px;
    line-height: 1.6;
  }

  .submit-btn {
    cursor: pointer;
    border: none;
    border-radius: 999px;
    padding: 16px 26px;
    font: inherit;
    font-weight: 800;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, #00ff41, #7dff97);
    color: #031504;
    box-shadow: 0 14px 30px rgba(0, 255, 65, 0.22);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      opacity 0.2s ease;
  }

  .submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 36px rgba(0, 255, 65, 0.28);
  }

  .submit-btn:disabled {
    opacity: 0.72;
    cursor: wait;
    transform: none;
    box-shadow: none;
  }

  .is-hidden {
    display: none !important;
  }

  @media (max-width: 820px) {
    .feedback-page {
      padding: 78px 0 64px;
    }

    .hero,
    .success-panel,
    .form-shell {
      padding: 22px;
      border-radius: 24px;
    }

    .form-shell-header,
    .inline-fields,
    .contact-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 14px;
    }

    .survey-grid {
      grid-template-columns: 1fr;
    }

    .question-card--wide,
    .contact-card {
      grid-column: auto;
    }

    .scale-grid {
      gap: 8px;
    }

    .scale-pill {
      padding: 12px 8px;
    }

    .form-actions {
      align-items: stretch;
    }

    .submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  const initFeedbackForm = () => {
    const form = document.getElementById('feedbackForm');
    const status = document.getElementById('feedbackFormStatus');
    const successPanel = document.getElementById('feedbackSuccess');
    const rewardCodeValue = document.getElementById('rewardCodeValue');
    const redeemNowButton = document.getElementById('redeemNowButton');
    const submitBtn = document.getElementById('feedbackSubmitBtn');

    if (!form || !status || !successPanel || !rewardCodeValue || !redeemNowButton || !submitBtn) return;
    if (form.dataset.jsInitialized === 'true') return;

    form.dataset.jsInitialized = 'true';

    const rewardCodeEncoded = 'UFJPRk9DVVM=';
    const appStoreAppId = '1609763784';
    const otherWrappers = Array.from(form.querySelectorAll('[data-other-wrapper]'));
    const otherToggles = Array.from(form.querySelectorAll('[data-other-target]'));

    const setStatus = (message) => {
      status.textContent = message;
      status.classList.remove('is-hidden');
      status.classList.add('is-error');
    };

    const clearStatus = () => {
      status.textContent = '';
      status.classList.add('is-hidden');
      status.classList.remove('is-error');
    };

    const clearFieldValue = (field) => {
      if (field instanceof HTMLInputElement && (field.type === 'checkbox' || field.type === 'radio')) {
        field.checked = false;
        return;
      }

      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        field.value = '';
      }
    };

    const syncOtherWrapper = (wrapperId) => {
      if (!wrapperId) return;

      const wrapper = document.getElementById(wrapperId);
      if (!wrapper) return;

      const relatedToggles = Array.from(form.querySelectorAll(`[data-other-target="${wrapperId}"]`));
      const isVisible = relatedToggles.some(
        (input) => input instanceof HTMLInputElement && !input.disabled && input.checked
      );

      wrapper.hidden = !isVisible;

      Array.from(wrapper.querySelectorAll('input, textarea, select')).forEach((field) => {
        if (
          !(
            field instanceof HTMLInputElement ||
            field instanceof HTMLTextAreaElement ||
            field instanceof HTMLSelectElement
          )
        ) {
          return;
        }

        const shouldRequire = isVisible && field.dataset.requiredWhenVisible === 'true';
        field.disabled = !isVisible;
        field.required = shouldRequire;

        if (!isVisible) {
          clearFieldValue(field);
        }
      });
    };

    const syncAllOtherWrappers = () => {
      otherWrappers.forEach((wrapper) => syncOtherWrapper(wrapper.id));
    };

    const decodeRewardCode = () => window.atob(rewardCodeEncoded);
    const makeRedeemURL = (code) =>
      `https://apps.apple.com/redeem?ctx=offercodes&id=${encodeURIComponent(appStoreAppId)}&code=${encodeURIComponent(code)}`;

    otherToggles.forEach((input) => {
      input.addEventListener('change', () => {
        syncOtherWrapper(input.dataset.otherTarget);
      });
    });

    syncAllOtherWrappers();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearStatus();

      if (!form.reportValidity()) {
        return;
      }

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (!response.ok) {
          throw new Error(`Request failed with status ${response.status}`);
        }

        const rewardCode = decodeRewardCode();
        rewardCodeValue.textContent = rewardCode;
        redeemNowButton.href = makeRedeemURL(rewardCode);
        status.classList.add('is-hidden');
        form.hidden = true;
        successPanel.classList.remove('is-hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        successPanel.focus();
      } catch (error) {
        setStatus('We could not send your survey right now. Please try again in a moment.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel || 'Send survey and show my code';
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeedbackForm, { once: true });
  } else {
    initFeedbackForm();
  }
</script>
